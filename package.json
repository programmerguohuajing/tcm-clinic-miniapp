{
  "name": "tcm-clinic-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "中医馆预约、健康档案与内嵌管理端小程序工程",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev:api": "pnpm --filter tcm-clinic-api dev",
    "dev:pc": "pnpm --filter tcm-clinic-pc-admin dev",
    "build:pc": "pnpm --filter tcm-clinic-pc-admin build",
    "dev:h5-admin": "pnpm --filter tcm-clinic-uni-admin dev:h5",
    "build:h5-admin": "pnpm --filter tcm-clinic-uni-admin build:h5",
    "build:mp-alipay-admin": "pnpm --filter tcm-clinic-uni-admin build:mp-alipay",
    "build:mp-toutiao-admin": "pnpm --filter tcm-clinic-uni-admin build:mp-toutiao",
    "build:admin": "pnpm --filter tcm-clinic-pc-admin build && pnpm --filter tcm-clinic-uni-admin build:h5",
    "start:api": "pnpm --filter tcm-clinic-api start",
    "db:init": "pnpm --filter tcm-clinic-api db:init",
    "db:seed": "pnpm --filter tcm-clinic-api db:seed"
  },
  "workspaces": [
    "backend",
    "pc-admin",
    "uni-admin",
    "packages/*"
  ]
}
