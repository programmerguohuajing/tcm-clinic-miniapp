.picker {
  padding: 20rpx 0;
  color: #2d3035;
  font-size: 28rpx;
  font-weight: 800;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.slot {
  padding: 24rpx;
  border: 2rpx solid rgba(222, 225, 228, 0.9);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  text-align: center;
}

.slot view {
  color: #2d3035;
  font-size: 28rpx;
  font-weight: 800;
}

.slot text {
  color: #73777d;
  font-size: 22rpx;
}

.slot.active {
  border-color: #e76f3c;
  background: #fff0e7;
}

.loading-text {
  text-align: center;
  color: #73777d;
  padding: 40rpx 0;
}
