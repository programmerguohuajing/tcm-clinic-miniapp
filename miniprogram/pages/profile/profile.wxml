<view class="page">
  <view class="hero-card profile-card">
    <view class="profile-row">
      <view class="avatar-letter">{{summary.user.initial}}</view>
      <view class="profile-main">
        <view class="title small">{{summary.user.nickname}}</view>
        <view class="subtitle">{{summary.user.member_level}} · {{summary.user.points}} 积分</view>
      </view>
    </view>
    <view class="stats">
      <view><text>{{summary.stats.appointments}}</text><label>预约</label></view>
      <view bindtap="goCoupons"><text>{{summary.stats.coupons}}</text><label>优惠券</label></view>
      <view><text>{{summary.stats.familyMembers}}</text><label>家人</label></view>
    </view>
  </view>

  <view class="grid-two action-grid">
    <button wx:if="{{canManage}}" class="ghost-button" bindtap="goAdmin">管理端</button>
    <button wx:if="{{canTechnician}}" class="ghost-button" bindtap="goTechnician">技师端</button>
    <button class="ghost-button" open-type="share">邀请好友</button>
  </view>

  <view class="menu-grid">
    <view class="menu-item" bindtap="goMessages">
      <view class="menu-icon menu-icon-message"></view><text>消息中心</text>
    </view>
    <view class="menu-item" bindtap="goMember">
      <view class="menu-icon menu-icon-member"></view><text>会员权益</text>
    </view>
    <view class="menu-item" bindtap="goFavorites">
      <view class="menu-icon menu-icon-favorite"></view><text>我的收藏</text>
    </view>
    <view class="menu-item" bindtap="goSettings">
      <view class="menu-icon menu-icon-settings"></view><text>设置</text>
    </view>
  </view>

  <view class="section-title"><text>我的疗愈预约</text></view>
  <view wx:if="{{!appointments.length}}" class="list-card empty-card">暂无预约记录</view>
  <block wx:for="{{appointments}}" wx:key="id">
    <view class="list-card order-card" bindtap="goOrderDetail" data-id="{{item.id}}">
      <view class="order-top">
        <image wx:if="{{item.practitioner_avatar_url}}" class="order-avatar" src="{{item.practitioner_avatar_url}}" mode="aspectFill" />
        <view class="order-info">
          <view class="order-title">{{item.service_name}}</view>
          <view class="subtitle">{{item.practitioner_name}} · {{item.appointment_date}} {{item.startLabel}}</view>
        </view>
        <text class="pill">{{statusText[item.status] || item.status}}</text>
      </view>
      <view class="price">¥{{item.amount}}</view>
    </view>
  </block>

  <view class="section-title"><text>同行家人</text></view>
  <block wx:for="{{familyMembers}}" wx:key="id">
    <view class="list-card family-card">
      <text>{{item.name}}</text>
      <label>{{item.relation}}</label>
    </view>
  </block>
</view>
