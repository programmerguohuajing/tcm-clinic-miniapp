.profile-card {
  padding: 38rpx;
  background:
    linear-gradient(145deg, rgba(43, 39, 34, 0.92), rgba(94, 84, 70, 0.82)),
    radial-gradient(circle at 78% 18%, rgba(187, 169, 143, 0.28), transparent 240rpx);
}

.profile-card .title,
.profile-card .subtitle {
  color: #f8ead1;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-letter {
  width: 120rpx;
  height: 120rpx;
  border: 1rpx solid rgba(248, 234, 209, 0.36);
  border-radius: 999rpx;
  color: #2b2722;
  background: linear-gradient(135deg, #f8ead1, #bba98f);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 120rpx;
  text-align: center;
}

.small {
  font-size: 38rpx;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 34rpx;
}

.stats view {
  padding: 20rpx;
  border: 1rpx solid rgba(248, 234, 209, 0.12);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.08);
  text-align: center;
}

.stats text {
  display: block;
  color: #f8ead1;
  font-size: 36rpx;
  font-weight: 700;
}

.stats label {
  color: rgba(248, 234, 209, 0.68);
  font-size: 22rpx;
}

.action-grid {
  margin-top: 24rpx;
}

.order-card,
.family-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.order-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.order-title {
  color: #2b2722;
  font-size: 30rpx;
  font-weight: 700;
}

.family-card {
  display: flex;
  justify-content: space-between;
}

.family-card text {
  color: #2b2722;
  font-weight: 700;
}

.family-card label {
  color: #8c8172;
}
