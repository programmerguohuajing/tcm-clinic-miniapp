.profile-card {
  padding: 38rpx;
  background:
    linear-gradient(145deg, rgba(255, 253, 248, 0.94), rgba(247, 241, 230, 0.82)),
    radial-gradient(circle at 78% 18%, rgba(47, 125, 107, 0.12), transparent 240rpx);
}

.profile-card .title {
  color: #24342f;
}

.profile-card .subtitle {
  color: #6f675d;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-main {
  min-width: 0;
  flex: 1;
}

.avatar-letter {
  width: 120rpx;
  height: 120rpx;
  border: 1rpx solid rgba(47, 125, 107, 0.18);
  border-radius: 999rpx;
  color: #2f7d6b;
  background: rgba(143, 175, 138, 0.16);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 120rpx;
  text-align: center;
}

.small {
  font-size: 38rpx;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 34rpx;
}

.stats view {
  padding: 20rpx;
  border: 1rpx solid rgba(92, 72, 48, 0.12);
  border-radius: 24rpx;
  background: rgba(255, 253, 248, 0.78);
  text-align: center;
}

.stats text {
  display: block;
  color: #2f7d6b;
  font-size: 36rpx;
  font-weight: 700;
}

.stats label {
  color: #81786b;
  font-size: 22rpx;
}

.action-grid {
  margin-top: 24rpx;
}

.empty-card {
  padding: 34rpx;
  color: #81786b;
  text-align: center;
}

.order-card,
.family-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.order-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.order-info {
  min-width: 0;
  flex: 1;
}

.order-title {
  color: #24342f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.family-card {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.family-card text {
  color: #24342f;
  font-weight: 700;
}

.family-card label {
  color: #81786b;
}
