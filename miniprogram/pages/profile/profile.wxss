.profile-card {
  padding: 36rpx;
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.96), rgba(231, 247, 241, 0.74)),
    radial-gradient(circle at 78% 18%, rgba(185, 242, 223, 0.5), transparent 240rpx);
}

.profile-card .title {
  color: #10241e;
}

.profile-card .subtitle {
  color: #6a7c75;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-main {
  min-width: 0;
  flex: 1;
}

.avatar-letter {
  width: 120rpx;
  height: 120rpx;
  border: 1rpx solid #c8ebde;
  border-radius: 999rpx;
  color: #18a67d;
  background: #e7f7f1;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 120rpx;
  text-align: center;
}

.small {
  font-size: 38rpx;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 34rpx;
}

.stats view {
  padding: 20rpx;
  border: 1rpx solid rgba(200, 235, 222, 0.9);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.86);
  text-align: center;
}

.stats text {
  display: block;
  color: #18a67d;
  font-size: 36rpx;
  font-weight: 800;
}

.stats label {
  color: #6a7c75;
  font-size: 22rpx;
}

.action-grid {
  margin-top: 24rpx;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 0;
  border: 1rpx solid rgba(200, 235, 222, 0.9);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #10241e;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.menu-icon {
  font-size: 36rpx;
}

.empty-card {
  padding: 34rpx;
  color: #6a7c75;
  text-align: center;
}

.order-card,
.family-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.order-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.order-info {
  min-width: 0;
  flex: 1;
}

.order-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
}

.order-title {
  color: #10241e;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.family-card {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.family-card text {
  min-width: 0;
  color: #10241e;
  font-weight: 800;
  line-height: 1.4;
}

.family-card label {
  flex-shrink: 0;
  color: #6a7c75;
}
