.profile-card {
  padding: 36rpx;
  background: #ffffff;
}

.profile-card .title {
  color: #2d3035;
}

.profile-card .subtitle {
  color: #73777d;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-main {
  min-width: 0;
  flex: 1;
}

.avatar-letter {
  width: 120rpx;
  height: 120rpx;
  border: 1rpx solid #dee1e4;
  border-radius: 999rpx;
  color: #e76f3c;
  background: #fff0e7;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 120rpx;
  text-align: center;
}

.small {
  font-size: 38rpx;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 34rpx;
}

.stats view {
  padding: 20rpx;
  border: 1rpx solid rgba(222, 225, 228, 0.9);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.86);
  text-align: center;
}

.stats text {
  display: block;
  color: #e76f3c;
  font-size: 36rpx;
  font-weight: 800;
}

.stats label {
  color: #73777d;
  font-size: 22rpx;
}

.action-grid {
  margin-top: 24rpx;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 0;
  border: 1rpx solid rgba(222, 225, 228, 0.9);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #2d3035;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.menu-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  color: #e76f3c;
}

.menu-icon::before,
.menu-icon::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.menu-icon-message::before {
  left: 4rpx;
  top: 5rpx;
  width: 30rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
}

.menu-icon-message::after {
  left: 11rpx;
  bottom: 3rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: skewY(-35deg);
}

.menu-icon-member::before {
  left: 4rpx;
  top: 8rpx;
  width: 30rpx;
  height: 22rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  transform: rotate(45deg);
}

.menu-icon-member::after {
  left: 13rpx;
  top: 0;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  background: #ffffff;
}

.menu-icon-favorite::before {
  left: 5rpx;
  top: 4rpx;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.menu-icon-favorite::after {
  left: 14rpx;
  top: 11rpx;
  width: 10rpx;
  height: 10rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.menu-icon-settings::before {
  left: 5rpx;
  top: 5rpx;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.menu-icon-settings::after {
  left: 14rpx;
  top: 14rpx;
  width: 10rpx;
  height: 10rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.empty-card {
  padding: 34rpx;
  color: #73777d;
  text-align: center;
}

.order-card,
.family-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.order-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.order-info {
  min-width: 0;
  flex: 1;
}

.order-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
}

.order-title {
  color: #2d3035;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.family-card {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.family-card text {
  min-width: 0;
  color: #2d3035;
  font-weight: 800;
  line-height: 1.4;
}

.family-card label {
  flex-shrink: 0;
  color: #73777d;
}
