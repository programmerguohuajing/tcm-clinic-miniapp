.pay-card {
  text-align: center;
  padding: 60rpx 36rpx;
  border: 1rpx solid rgba(222, 225, 228, 0.9);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 44rpx rgba(45, 48, 53, 0.08);
}

.pay-icon {
  color: #e76f3c;
  font-size: 40rpx;
  font-weight: 800;
}

.pay-amount {
  margin-top: 12rpx;
  color: #2d3035;
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1.1;
}

.pay-card .subtitle {
  margin-top: 18rpx;
  color: #73777d;
  font-size: 26rpx;
}

.card {
  margin-top: 22rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(222, 225, 228, 0.9);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 44rpx rgba(45, 48, 53, 0.08);
}

.card-title {
  margin-bottom: 18rpx;
  color: #2d3035;
  font-size: 28rpx;
  font-weight: 800;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(222, 225, 228, 0.4);
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-row .label {
  color: #73777d;
  font-size: 26rpx;
}

.detail-row text:last-child {
  color: #2d3035;
  font-weight: 800;
  font-size: 26rpx;
  max-width: 60%;
  text-align: right;
}

.tip-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fffbe6;
  border: 1rpx solid rgba(250, 204, 21, 0.3);
}

.tip-text {
  color: #73777d;
  font-size: 24rpx;
  line-height: 1.6;
}

.pay-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 50rpx;
  height: 92rpx;
  border: none;
  border-radius: 999rpx;
  color: #ffffff;
  background: #e76f3c;
  box-shadow: 0 18rpx 34rpx rgba(231, 111, 60, 0.22);
  font-size: 30rpx;
  font-weight: 800;
}
