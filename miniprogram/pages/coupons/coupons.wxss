.tab-bar {
  display: flex;
  border-bottom: 1rpx solid rgba(200, 235, 222, 0.6);
  margin-bottom: 22rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  color: #6a7c75;
  font-size: 26rpx;
  font-weight: 800;
  position: relative;
}

.tab.active {
  color: #18a67d;
}

.tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 4rpx;
  background: #18a67d;
  border-radius: 2rpx;
}

.coupon-card {
  display: flex;
  margin-bottom: 22rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 28rpx;
}

.coupon-left {
  width: 200rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  background: #e7f7f1;
  border-right: 2rpx dashed rgba(200, 235, 222, 0.9);
  flex-shrink: 0;
}

.coupon-amount {
  color: #18a67d;
  font-size: 48rpx;
  font-weight: 800;
}

.coupon-condition {
  margin-top: 8rpx;
  color: #6a7c75;
  font-size: 20rpx;
}

.coupon-right {
  flex: 1;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-title {
  color: #10241e;
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.coupon-expiry {
  color: #8aa099;
  font-size: 22rpx;
}

.coupon-used {
  opacity: 0.6;
}

.coupon-used .coupon-left {
  background: #f4f4f5;
}

.coupon-used .coupon-amount {
  color: #8aa099;
}
