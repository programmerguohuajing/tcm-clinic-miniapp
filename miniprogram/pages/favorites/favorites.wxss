.tab-bar {
  display: flex;
  border-bottom: 1rpx solid rgba(222, 225, 228, 0.6);
  margin-bottom: 22rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  color: #73777d;
  font-size: 26rpx;
  font-weight: 800;
  position: relative;
}

.tab.active {
  color: #e76f3c;
}

.tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 4rpx;
  background: #e76f3c;
  border-radius: 2rpx;
}

.fav-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.fav-name {
  color: #2d3035;
  font-size: 30rpx;
  font-weight: 800;
}

.remove-btn {
  align-self: flex-end;
  padding: 8rpx 24rpx;
  border: 1rpx solid #dee1e4;
  border-radius: 999rpx;
  color: #c0392b;
  background: transparent;
  font-size: 22rpx;
  font-weight: 700;
  margin-top: 8rpx;
  min-height: 56rpx;
  line-height: 56rpx;
}

.remove-btn::after {
  border: 0;
}

.fav-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar-small {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff0e7;
  color: #e76f3c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
