.tab-bar {
  display: flex;
  border-bottom: 1rpx solid rgba(200, 235, 222, 0.6);
  margin-bottom: 22rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  color: #6a7c75;
  font-size: 26rpx;
  font-weight: 800;
  position: relative;
}

.tab.active {
  color: #18a67d;
}

.tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 4rpx;
  background: #18a67d;
  border-radius: 2rpx;
}

.fav-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.fav-name {
  color: #10241e;
  font-size: 30rpx;
  font-weight: 800;
}

.remove-btn {
  align-self: flex-end;
  padding: 8rpx 24rpx;
  border: 1rpx solid #c8ebde;
  border-radius: 999rpx;
  color: #c0392b;
  background: transparent;
  font-size: 22rpx;
  font-weight: 700;
  margin-top: 8rpx;
  min-height: 56rpx;
  line-height: 56rpx;
}

.remove-btn::after {
  border: 0;
}
