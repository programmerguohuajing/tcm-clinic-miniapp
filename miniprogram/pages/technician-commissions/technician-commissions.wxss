.commission-hero {
  padding: 42rpx;
  background:
    linear-gradient(145deg, rgba(255, 253, 248, 0.94), rgba(248, 244, 236, 0.86)),
    radial-gradient(circle at 82% 12%, rgba(196, 132, 54, 0.14), transparent 230rpx);
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.metric {
  padding: 28rpx;
  border: 1rpx solid rgba(196, 132, 54, 0.14);
  border-radius: 28rpx;
  background: rgba(255, 253, 248, 0.82);
  box-shadow: 0 8rpx 24rpx rgba(62, 49, 34, 0.06);
}

.metric text {
  display: block;
  color: #b36b28;
  font-size: 38rpx;
  font-weight: 700;
}

.metric label {
  color: #81786b;
  font-size: 22rpx;
}

.commission-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.order-title {
  color: #24342f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.commission-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  color: #81786b;
  font-size: 24rpx;
}

.commission-row text:last-child {
  flex-shrink: 0;
  text-align: right;
}

.empty-card {
  padding: 34rpx;
  color: #81786b;
  text-align: center;
}
