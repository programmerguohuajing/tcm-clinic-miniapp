.health-hero {
  padding: 42rpx;
  background:
    linear-gradient(145deg, rgba(255, 253, 248, 0.92), rgba(247, 241, 230, 0.78)),
    radial-gradient(circle at 78% 18%, rgba(143, 175, 138, 0.14), transparent 240rpx);
}

.form-card {
  margin-top: 28rpx;
  padding: 30rpx;
}

.compact {
  margin-top: 0;
}

.input,
.textarea {
  width: 100%;
  margin-bottom: 18rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(92, 72, 48, 0.12);
  border-radius: 24rpx;
  background: rgba(255, 253, 248, 0.84);
  box-sizing: border-box;
  color: #2f3a35;
  font-size: 28rpx;
}

.input {
  height: 84rpx;
  line-height: 84rpx;
}

.textarea {
  min-height: 150rpx;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
  line-height: 1.6;
}

.record-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.record-top {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.record-heading {
  min-width: 0;
  width: 100%;
}

.record-meta-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  width: 100%;
}

.delete-record {
  min-width: 104rpx;
  min-height: 64rpx;
  padding: 0 18rpx;
  color: #b42318;
  font-size: 22rpx;
}

.record-title {
  min-width: 0;
  color: #24342f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 18rpx 0;
}

.tags text {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #2f7d6b;
  background: rgba(143, 175, 138, 0.14);
  font-size: 22rpx;
  line-height: 1.35;
}
