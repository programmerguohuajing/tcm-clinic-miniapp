.health-hero {
  padding: 38rpx;
  background: #ffffff;
}

.form-card {
  margin-top: 28rpx;
  padding: 30rpx;
}

.compact {
  margin-top: 0;
}

.input,
.textarea {
  width: 100%;
  margin-bottom: 18rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dee1e4;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-sizing: border-box;
  color: #2d3035;
  font-size: 28rpx;
}

.input {
  height: 84rpx;
  line-height: 84rpx;
}

.textarea {
  min-height: 150rpx;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
  line-height: 1.6;
}

.record-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.record-top {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.record-heading {
  min-width: 0;
  width: 100%;
}

.record-meta-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  width: 100%;
}

.delete-record {
  min-width: 104rpx;
  min-height: 64rpx;
  padding: 0 18rpx;
  color: #b42318;
  font-size: 22rpx;
}

.record-title {
  min-width: 0;
  color: #2d3035;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 18rpx 0;
}

.tags text {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #e76f3c;
  background: #fff0e7;
  font-size: 22rpx;
  line-height: 1.35;
}
