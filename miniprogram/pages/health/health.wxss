.health-hero {
  padding: 42rpx;
  background:
    linear-gradient(145deg, rgba(255, 250, 243, 0.7), rgba(221, 211, 197, 0.56)),
    radial-gradient(circle at 78% 18%, rgba(187, 169, 143, 0.28), transparent 240rpx);
}

.form-card {
  margin-top: 28rpx;
  padding: 30rpx;
}

.compact {
  margin-top: 0;
}

.input,
.textarea {
  width: 100%;
  margin-bottom: 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(47, 43, 37, 0.1);
  border-radius: 28rpx;
  background: rgba(255, 250, 243, 0.72);
  box-sizing: border-box;
}

.textarea {
  min-height: 150rpx;
}

.record-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.record-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-title {
  color: #2b2722;
  font-size: 32rpx;
  font-weight: 700;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 18rpx 0;
}

.tags text {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #6f5836;
  background: rgba(187, 169, 143, 0.2);
  font-size: 22rpx;
}
