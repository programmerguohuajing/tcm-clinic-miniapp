.member-card {
  padding: 44rpx 36rpx;
  text-align: center;
  border: 1rpx solid rgba(222, 225, 228, 0.9);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 44rpx rgba(45, 48, 53, 0.08);
}

.member-level {
  color: #2d3035;
  font-size: 40rpx;
  font-weight: 800;
}

.member-points {
  margin-top: 18rpx;
  color: #e76f3c;
  font-size: 52rpx;
  font-weight: 800;
}

.progress-bar {
  margin-top: 28rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #dee1e4;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: #e76f3c;
  transition: width 0.4s;
}

.progress-text {
  margin-top: 14rpx;
  color: #73777d;
  font-size: 22rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.benefit-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #fff0e7;
  color: #e76f3c;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.benefit-text {
  color: #2d3035;
  font-size: 26rpx;
  font-weight: 700;
}
