.store-header {
  margin-bottom: 22rpx;
}

.store-name {
  color: #2d3035;
  font-size: 36rpx;
  font-weight: 800;
}

.store-tags {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.action-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.action-btn {
  flex: 1;
  min-height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid #dee1e4;
  border-radius: 999rpx;
  color: #e76f3c;
  background: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 72rpx;
  text-align: center;
}

.action-btn::after {
  border: 0;
}

.action-btn.primary {
  background: #e76f3c;
  color: #ffffff;
}

.service-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
}

.service-item .service-name {
  color: #2d3035;
  font-size: 28rpx;
  font-weight: 800;
}

.service-item .subtitle {
  font-size: 22rpx;
}

.service-item .price {
  color: #e76f3c;
  font-size: 32rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.empty-card {
  padding: 34rpx;
  color: #73777d;
  text-align: center;
}
