.review-summary {
  text-align: center;
  padding: 36rpx 0;
}

.reviewed-service {
  color: #10241e;
  font-size: 34rpx;
  font-weight: 800;
}

.review-summary .subtitle {
  margin-top: 12rpx;
  color: #6a7c75;
  font-size: 26rpx;
}

.rating-card {
  text-align: center;
  padding: 40rpx 28rpx;
}

.card-title {
  margin-bottom: 24rpx;
  color: #10241e;
  font-size: 28rpx;
  font-weight: 800;
}

.stars {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.star {
  font-size: 60rpx;
  color: #c8ebde;
  transition: color 0.15s;
}

.star.active {
  color: #f5a623;
}

.rating-label {
  margin-top: 18rpx;
  color: #6a7c75;
  font-size: 24rpx;
}

.review-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(244, 251, 248, 0.6);
  border: 1rpx solid rgba(200, 235, 222, 0.6);
  color: #10241e;
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  margin-top: 12rpx;
  color: #8aa099;
  font-size: 22rpx;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 50rpx;
  height: 92rpx;
  border: none;
  border-radius: 999rpx;
  color: #ffffff;
  background: #18a67d;
  box-shadow: 0 18rpx 34rpx rgba(24, 166, 125, 0.22);
  font-size: 30rpx;
  font-weight: 800;
}
