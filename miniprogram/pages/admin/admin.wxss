.admin-hero {
  padding: 42rpx;
  background:
    linear-gradient(145deg, rgba(43, 39, 34, 0.94), rgba(94, 84, 70, 0.82)),
    radial-gradient(circle at 82% 12%, rgba(187, 169, 143, 0.28), transparent 230rpx);
}

.admin-hero .title,
.admin-hero .subtitle {
  color: #f8ead1;
}

.admin-hero .eyebrow {
  color: #d8c39e;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.metric {
  padding: 28rpx;
  border: 1rpx solid rgba(47, 43, 37, 0.1);
  border-radius: 34rpx;
  background: rgba(255, 250, 243, 0.68);
  box-shadow: 0 18rpx 46rpx rgba(47, 43, 37, 0.08);
}

.metric text {
  display: block;
  color: #2b2722;
  font-size: 38rpx;
  font-weight: 700;
}

.metric label {
  color: #8c8172;
  font-size: 22rpx;
}

.admin-order {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.order-title {
  color: #2b2722;
  font-size: 30rpx;
  font-weight: 700;
}

.admin-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.mini {
  width: 180rpx;
  height: 64rpx;
  padding: 0;
  font-size: 24rpx;
  line-height: 64rpx;
}
