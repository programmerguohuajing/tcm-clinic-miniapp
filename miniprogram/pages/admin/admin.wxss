.admin-page {
  padding-bottom: 80rpx;
}

.admin-hero {
  padding: 38rpx;
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.96), rgba(231, 247, 241, 0.74)),
    radial-gradient(circle at 82% 12%, rgba(185, 242, 223, 0.5), transparent 230rpx);
}

.admin-hero .title {
  color: #10241e;
}

.admin-hero .subtitle {
  color: #6a7c75;
}

.admin-hero .eyebrow {
  color: #18a67d;
}

.toolbar-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 20rpx;
  border: 1rpx solid #c8ebde;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 14rpx 34rpx rgba(16, 36, 30, 0.07);
}

.store-picker,
.refresh-button,
.primary-action,
.ghost-action {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.store-picker {
  flex: 1;
  min-width: 0;
  color: #18a67d;
  background: #e7f7f1;
}

.refresh-button,
.ghost-action {
  min-width: 128rpx;
  color: #47645b;
  background: #f3faf7;
}

.tabs-scroll {
  margin: 24rpx -24rpx 0;
  white-space: nowrap;
}

.tabs-track {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 8rpx;
}

.tab {
  flex: 0 0 auto;
  padding: 18rpx 26rpx;
  border: 1rpx solid #c8ebde;
  border-radius: 999rpx;
  color: #47645b;
  background: rgba(255, 255, 255, 0.86);
  font-size: 26rpx;
  font-weight: 700;
}

.tab.active {
  color: #ffffff;
  background: #18a67d;
  box-shadow: 0 10rpx 24rpx rgba(24, 166, 125, 0.22);
}

.loading-card,
.empty-card,
.empty {
  padding: 36rpx;
  border-radius: 26rpx;
  color: #6a7c75;
  background: rgba(255, 255, 255, 0.8);
  text-align: center;
  font-size: 26rpx;
}

.loading-card,
.empty-card {
  margin-top: 24rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.metric {
  padding: 28rpx;
  border: 1rpx solid #c8ebde;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 12rpx 28rpx rgba(16, 36, 30, 0.06);
}

.metric text {
  display: block;
  color: #18a67d;
  font-size: 38rpx;
  font-weight: 800;
}

.metric label {
  color: #6a7c75;
  font-size: 22rpx;
}

.rank-card,
.module-head {
  margin-top: 24rpx;
  padding: 26rpx;
  border: 1rpx solid #c8ebde;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 12rpx 30rpx rgba(16, 36, 30, 0.06);
}

.rank-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(200, 235, 222, 0.8);
  color: #10241e;
  font-size: 26rpx;
}

.rank-row:last-child {
  border-bottom: 0;
}

.rank-value {
  color: #18a67d;
  font-weight: 800;
  text-align: right;
}

.module-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.module-title {
  min-width: 0;
  flex: 1;
}

.head-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.primary-action {
  min-width: 120rpx;
  padding: 0 18rpx;
  color: #ffffff;
  background: #18a67d;
}

.ghost-action {
  padding: 0 18rpx;
}

.record-card {
  margin-top: 18rpx;
  padding: 24rpx;
}

.record-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.record-copy {
  min-width: 0;
  flex: 1;
}

.record-title {
  color: #10241e;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.record-meta,
.record-detail {
  margin-top: 10rpx;
  color: #6a7c75;
  font-size: 24rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.record-value {
  flex-shrink: 0;
  color: #18a67d;
  font-size: 26rpx;
  font-weight: 800;
  text-align: right;
}

.record-actions,
.order-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
}

.order-actions {
  flex-wrap: wrap;
}

.mini,
.ghost.mini,
.primary.mini,
.danger.mini {
  min-width: 132rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.ghost.mini {
  color: #47645b;
  background: #f3faf7;
}

.primary.mini {
  color: #ffffff;
  background: #18a67d;
}

.danger.mini {
  color: #ffffff;
  background: #dc2626;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(16, 36, 30, 0.42);
}

.sheet {
  width: 100%;
  max-height: 86vh;
  padding: 28rpx 28rpx 48rpx;
  border-radius: 34rpx 34rpx 0 0;
  background: #ffffff;
  overflow-y: auto;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  color: #10241e;
  font-size: 32rpx;
  font-weight: 800;
}

.field {
  margin-bottom: 22rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #10241e;
  font-size: 25rpx;
  font-weight: 800;
}

.input,
.textarea,
.select-box {
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #c8ebde;
  border-radius: 18rpx;
  color: #10241e;
  background: #f8fffc;
  font-size: 27rpx;
}

.textarea {
  min-height: 150rpx;
  line-height: 1.55;
}

.checks {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.check-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: #f3faf7;
  color: #47645b;
  font-size: 24rpx;
}

.save-button {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: #18a67d;
  font-size: 30rpx;
  font-weight: 900;
}

.required {
  color: #dc2626;
}

.phone-error {
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(220, 38, 38, 0.08);
  border: 1rpx solid rgba(220, 38, 38, 0.2);
  color: #dc2626;
  font-size: 24rpx;
}
