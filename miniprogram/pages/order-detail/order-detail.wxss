.status-card {
  text-align: center;
  padding: 40rpx 36rpx;
}

.status-pill {
  font-size: 26rpx;
  margin-bottom: 18rpx;
}

.order-no {
  margin-top: 18rpx;
  color: #10241e;
  font-size: 30rpx;
  font-weight: 800;
}

.card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(200, 235, 222, 0.9);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 44rpx rgba(16, 36, 30, 0.08);
  box-sizing: border-box;
}

.card-title {
  margin-bottom: 18rpx;
  color: #10241e;
  font-size: 28rpx;
  font-weight: 800;
}

.service-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.service-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
  background: #e7f7f1;
  flex-shrink: 0;
}

.service-info {
  min-width: 0;
  flex: 1;
}

.service-name {
  color: #10241e;
  font-size: 30rpx;
  font-weight: 800;
}

.practitioner-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-small {
  width: 88rpx;
  height: 88rpx;
  border: 1rpx solid #c8ebde;
  border-radius: 999rpx;
  color: #18a67d;
  background: #e7f7f1;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 88rpx;
  text-align: center;
  flex-shrink: 0;
}

.practitioner-name {
  color: #10241e;
  font-size: 30rpx;
  font-weight: 800;
}

.practitioner-name text {
  color: #6a7c75;
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 12rpx;
}

.link-button {
  display: inline-block;
  margin-top: 16rpx;
  padding: 0 24rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  border: 1rpx solid #18a67d;
  border-radius: 999rpx;
  color: #18a67d;
  background: transparent;
  font-size: 24rpx;
  font-weight: 800;
}

.link-button::after {
  border: 0;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.row text:first-child {
  color: #6a7c75;
}

.price {
  color: #18a67d;
  font-weight: 800;
}

.action-bar {
  display: flex;
  gap: 18rpx;
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

.action-bar .primary-button,
.action-bar .danger-button {
  flex: 1;
}

.danger-button {
  background: #c0392b;
  box-shadow: 0 18rpx 34rpx rgba(192, 57, 43, 0.22);
}
