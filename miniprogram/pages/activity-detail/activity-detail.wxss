.cover-image {
  width: 100%;
  max-height: 420rpx;
  border-radius: 36rpx;
  background: #e7f7f1;
  margin-bottom: 28rpx;
}

.activity-header {
  margin-bottom: 28rpx;
}

.activity-header .pill {
  margin-bottom: 18rpx;
}

.activity-title {
  color: #10241e;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
  margin-bottom: 14rpx;
}

.price-card {
  padding: 28rpx 28rpx 28rpx 28rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.current-price {
  color: #18a67d;
  font-size: 52rpx;
  font-weight: 800;
}

.original-price {
  margin-top: 8rpx;
  color: #8aa099;
  font-size: 26rpx;
  text-decoration: line-through;
}

.validity {
  color: #6a7c75;
  font-size: 22rpx;
}

.book-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 50rpx;
  height: 92rpx;
  border: none;
  border-radius: 999rpx;
  color: #ffffff;
  background: #18a67d;
  box-shadow: 0 18rpx 34rpx rgba(24, 166, 125, 0.22);
  font-size: 30rpx;
  font-weight: 800;
}
