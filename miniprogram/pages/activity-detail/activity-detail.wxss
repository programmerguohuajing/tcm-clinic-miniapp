.cover-image {
  width: 100%;
  max-height: 420rpx;
  border-radius: 36rpx;
  background: #fff0e7;
  margin-bottom: 28rpx;
}

.activity-header {
  margin-bottom: 28rpx;
}

.activity-header .pill {
  margin-bottom: 18rpx;
}

.activity-title {
  color: #2d3035;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
  margin-bottom: 14rpx;
}

.price-card {
  padding: 28rpx 28rpx 28rpx 28rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.current-price {
  color: #e76f3c;
  font-size: 52rpx;
  font-weight: 800;
}

.original-price {
  margin-top: 8rpx;
  color: #9aa0a6;
  font-size: 26rpx;
  text-decoration: line-through;
}

.validity {
  color: #73777d;
  font-size: 22rpx;
}

.book-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 50rpx;
  height: 92rpx;
  border: none;
  border-radius: 999rpx;
  color: #ffffff;
  background: #e76f3c;
  box-shadow: 0 18rpx 34rpx rgba(231, 111, 60, 0.22);
  font-size: 30rpx;
  font-weight: 800;
}
