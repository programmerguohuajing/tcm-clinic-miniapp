.login-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 48rpx;
  background:
    radial-gradient(circle at 18% 10%, rgba(199, 223, 255, 0.78), transparent 30%),
    radial-gradient(circle at 88% 18%, rgba(17, 181, 217, 0.12), transparent 28%),
    linear-gradient(135deg, #f4f8ff 0%, #ffffff 52%, #e8f1ff 100%);
}

.login-card {
  width: min(640rpx, 100%);
  border: 1rpx solid rgba(199, 223, 255, 0.9);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 28rpx 80rpx rgba(28, 60, 112, 0.12);
  overflow: hidden;
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 44rpx 38rpx 32rpx;
}

.login-seal {
  width: 96rpx;
  height: 96rpx;
  display: grid;
  place-items: center;
  border: 1rpx solid rgba(207, 224, 255, 0.9);
  border-radius: 30rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #3478f6, #11b5d9);
  font-size: 48rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 28rpx rgba(52, 120, 246, 0.24);
  flex-shrink: 0;
}

.login-brand-sub {
  display: block;
  color: #3478f6;
  font-size: 22rpx;
  letter-spacing: 0.18em;
  font-weight: 800;
}

.login-brand-title {
  display: block;
  margin-top: 6rpx;
  color: #101c2e;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.login-body {
  padding: 0 38rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 36rpx;
}

.login-illustration {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.login-illustration-icon {
  font-size: 88rpx;
  line-height: 1;
}

.login-illustration-text {
  color: #10241e;
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
  line-height: 1.5;
  white-space: pre-line;
}

.login-notice {
  width: 100%;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(231, 247, 241, 0.6);
  border: 1rpx solid rgba(200, 235, 222, 0.8);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.login-notice-title {
  color: #18a67d;
  font-size: 26rpx;
  font-weight: 800;
}

.login-notice-desc {
  color: #6a7c75;
  font-size: 24rpx;
  line-height: 1.5;
}

.login-button {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: 0;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #18a67d, #14d4a0);
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 28rpx rgba(24, 166, 125, 0.28);
  line-height: 1;
}

.login-button[disabled] {
  opacity: 0.6;
}

.login-button-icon {
  font-size: 34rpx;
}

.login-error {
  width: 100%;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(220, 38, 38, 0.08);
  border: 1rpx solid rgba(220, 38, 38, 0.2);
  color: #dc2626;
  font-size: 24rpx;
  text-align: center;
}

.login-terms {
  color: #8aa099;
  font-size: 22rpx;
  text-align: center;
  line-height: 1.5;
}

.login-terms-link {
  color: #3478f6;
  text-decoration: underline;
}
