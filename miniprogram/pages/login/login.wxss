.login-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 48rpx;
  background: #ffffff;
}

.login-card {
  width: min(640rpx, 100%);
  border: 1rpx solid #dee1e4;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 38rpx rgba(45, 48, 53, 0.08);
  overflow: hidden;
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 44rpx 38rpx 32rpx;
}

.login-seal {
  width: 96rpx;
  height: 96rpx;
  display: grid;
  place-items: center;
  border: 1rpx solid #ffd8c7;
  border-radius: 16rpx;
  color: #ffffff;
  background: #e76f3c;
  font-size: 48rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 22rpx rgba(231, 111, 60, 0.2);
  flex-shrink: 0;
}

.login-brand-sub {
  display: block;
  color: #e76f3c;
  font-size: 22rpx;
  letter-spacing: 0.18em;
  font-weight: 800;
}

.login-brand-title {
  display: block;
  margin-top: 6rpx;
  color: #2d3035;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.login-body {
  padding: 0 38rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 36rpx;
}

.login-illustration {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.login-illustration-icon {
  font-size: 88rpx;
  line-height: 1;
}

.login-illustration-text {
  color: #2d3035;
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
  line-height: 1.5;
  white-space: pre-line;
}

.login-notice {
  width: 100%;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff0e7;
  border: 1rpx solid #ffd8c7;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.login-notice-title {
  color: #e76f3c;
  font-size: 26rpx;
  font-weight: 800;
}

.login-notice-desc {
  color: #73777d;
  font-size: 24rpx;
  line-height: 1.5;
}

.login-button {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: 0;
  border-radius: 20rpx;
  color: #ffffff;
  background: #e76f3c;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 28rpx rgba(231, 111, 60, 0.28);
  line-height: 1;
}

.login-button[disabled] {
  opacity: 0.6;
}

.login-button-icon {
  display: none;
}

.login-error {
  width: 100%;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(220, 38, 38, 0.08);
  border: 1rpx solid rgba(220, 38, 38, 0.2);
  color: #dc2626;
  font-size: 24rpx;
  text-align: center;
}

.login-terms {
  color: #9aa0a6;
  font-size: 22rpx;
  text-align: center;
  line-height: 1.5;
}

.login-terms-link {
  color: #e76f3c;
  text-decoration: underline;
}
