<view class="page">
  <view class="hero-card technician-hero">
    <view class="eyebrow">TECHNICIAN DESK</view>
    <view class="title">{{summary.profile.name}}</view>
    <view class="subtitle">{{summary.profile.title}} · {{summary.profile.store_name || '未绑定门店'}}</view>
    <view class="avatar-row" wx:if="{{summary.profile.avatar_url}}">
      <image class="avatar-large" src="{{summary.profile.avatar_url}}" mode="aspectFill" />
    </view>
  </view>

  <view class="metric-grid">
    <view class="metric"><text>{{summary.cards.todayAppointments}}</text><label>今日预约</label></view>
    <view class="metric"><text>{{summary.cards.futureSchedules}}</text><label>可约排班</label></view>
    <view class="metric"><text>¥{{summary.cards.grossAmount}}</text><label>服务业绩</label></view>
    <view class="metric"><text>¥{{summary.cards.commissionAmount}}</text><label>预估提成</label></view>
  </view>

  <view class="grid-two action-grid">
    <button class="ghost-button" bindtap="goSchedules">我的排班</button>
    <button class="ghost-button" bindtap="goCommissions">我的提成</button>
  </view>

  <view class="section-title"><text>近期预约</text></view>
  <view wx:if="{{!appointments.length}}" class="list-card empty-card">暂无预约记录</view>
  <block wx:for="{{appointments}}" wx:key="id">
    <view class="list-card technician-order">
      <view class="order-title">{{item.service_name}}</view>
      <view class="subtitle">{{item.user_name}} · {{item.appointment_date}} {{item.startLabel}}</view>
      <view class="admin-actions">
        <text class="pill">{{statusText[item.status] || item.status}}</text>
        <text class="price">¥{{item.amount}}</text>
      </view>
    </view>
  </block>
</view>
