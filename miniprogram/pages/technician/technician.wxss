.technician-hero {
  padding: 42rpx;
  background:
    linear-gradient(145deg, rgba(255, 253, 248, 0.94), rgba(240, 248, 244, 0.86)),
    radial-gradient(circle at 82% 12%, rgba(47, 125, 107, 0.12), transparent 230rpx);
}

.technician-hero .title {
  color: #24342f;
}

.technician-hero .subtitle {
  color: #6f675d;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.metric {
  padding: 28rpx;
  border: 1rpx solid rgba(47, 125, 107, 0.12);
  border-radius: 28rpx;
  background: rgba(255, 253, 248, 0.82);
  box-shadow: 0 8rpx 24rpx rgba(62, 49, 34, 0.06);
}

.metric text {
  display: block;
  color: #2f7d6b;
  font-size: 38rpx;
  font-weight: 700;
}

.metric label {
  color: #81786b;
  font-size: 22rpx;
}

.action-grid {
  margin-top: 24rpx;
}

.technician-order {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.order-title {
  color: #24342f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.admin-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.empty-card {
  padding: 34rpx;
  color: #81786b;
  text-align: center;
}
