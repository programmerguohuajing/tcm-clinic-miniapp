.technician-hero {
  padding: 38rpx;
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.96), rgba(231, 247, 241, 0.74)),
    radial-gradient(circle at 82% 12%, rgba(185, 242, 223, 0.5), transparent 230rpx);
}

.technician-hero .title {
  color: #10241e;
}

.technician-hero .subtitle {
  color: #6a7c75;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.metric {
  padding: 28rpx;
  border: 1rpx solid #c8ebde;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 12rpx 28rpx rgba(16, 36, 30, 0.06);
}

.metric text {
  display: block;
  color: #18a67d;
  font-size: 38rpx;
  font-weight: 800;
}

.metric label {
  color: #6a7c75;
  font-size: 22rpx;
}

.action-grid {
  margin-top: 24rpx;
}

.technician-order {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.order-title {
  color: #10241e;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.admin-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.empty-card {
  padding: 34rpx;
  color: #6a7c75;
  text-align: center;
}
