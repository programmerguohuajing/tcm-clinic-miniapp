.cover-image {
  width: 100%;
  max-height: 420rpx;
  border-radius: 36rpx;
  background: #fff0e7;
  margin-bottom: 28rpx;
}

.article-header {
  margin-bottom: 28rpx;
}

.article-header .pill {
  margin-bottom: 18rpx;
}

.article-title {
  color: #2d3035;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
  margin-bottom: 16rpx;
}

.article-meta {
  display: flex;
  gap: 24rpx;
}

.summary {
  display: block;
  color: #e76f3c;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.divider {
  height: 1rpx;
  background: #dee1e4;
  margin-bottom: 24rpx;
}

.content-text {
  display: block;
  color: #2d3035;
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
