.booking-hero {
  padding: 38rpx;
  background: #ffffff;
}

.booking-hero .title {
  color: #2d3035;
}

.booking-hero .subtitle {
  color: #73777d;
}

.booking-hero .eyebrow {
  color: #e76f3c;
}

.chip-scroll {
  white-space: nowrap;
}

.service-chip {
  display: inline-block;
  width: 300rpx;
  min-height: 132rpx;
  margin-right: 18rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid rgba(222, 225, 228, 0.9);
  border-radius: 30rpx;
  color: #2d3035;
  background: rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  vertical-align: top;
}

.service-chip view {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-chip text {
  overflow: hidden;
  margin-top: 10rpx;
  color: #73777d;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-chip.active,
.practitioner-card.active,
.slot.active {
  border-color: #e76f3c;
  background: #fff0e7;
  box-shadow: 0 12rpx 30rpx rgba(231, 111, 60, 0.12);
}

.practitioner-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(222, 225, 228, 0.9);
}

.avatar {
  width: 118rpx;
  height: 118rpx;
  border-radius: 999rpx;
  background: #fff0e7;
  filter: saturate(0.95);
}

.practitioner-main {
  min-width: 0;
  flex: 1;
}

.practitioner-name {
  color: #2d3035;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.practitioner-name text {
  color: #73777d;
  font-size: 22rpx;
  font-weight: 400;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.tags text {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #e76f3c;
  background: #fff0e7;
  font-size: 20rpx;
}

.rating {
  color: #e76f3c;
  font-size: 30rpx;
  font-weight: 800;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.slot {
  padding: 24rpx;
  border: 2rpx solid rgba(222, 225, 228, 0.9);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
}

.slot view {
  color: #2d3035;
  font-size: 28rpx;
  font-weight: 800;
}

.slot text {
  color: #73777d;
  font-size: 22rpx;
}

.slot.disabled {
  opacity: 0.45;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  height: 92rpx;
  line-height: 1;
}
