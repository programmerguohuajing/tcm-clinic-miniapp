.booking-hero {
  padding: 42rpx;
  background:
    linear-gradient(145deg, rgba(255, 253, 248, 0.94), rgba(247, 241, 230, 0.82)),
    radial-gradient(circle at 82% 12%, rgba(47, 125, 107, 0.12), transparent 230rpx);
}

.booking-hero .title {
  color: #24342f;
}

.booking-hero .subtitle {
  color: #6f675d;
}

.booking-hero .eyebrow {
  color: #81715f;
}

.chip-scroll {
  white-space: nowrap;
}

.service-chip {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  width: 290rpx;
  height: 132rpx;
  margin-right: 18rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(92, 72, 48, 0.1);
  border-radius: 30rpx;
  color: #24342f;
  background: rgba(255, 253, 248, 0.82);
  box-sizing: border-box;
}

.service-chip view {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-chip text {
  overflow: hidden;
  margin-top: 10rpx;
  color: #81786b;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-chip.active,
.practitioner-card.active,
.slot.active {
  border-color: #2f7d6b;
  background: rgba(143, 175, 138, 0.16);
  box-shadow: 0 8rpx 24rpx rgba(47, 125, 107, 0.08);
}

.practitioner-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(92, 72, 48, 0.1);
}

.avatar {
  width: 118rpx;
  height: 118rpx;
  border-radius: 999rpx;
  filter: saturate(0.74);
}

.practitioner-main {
  min-width: 0;
  flex: 1;
}

.practitioner-name {
  color: #24342f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.practitioner-name text {
  color: #81786b;
  font-size: 22rpx;
  font-weight: 400;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.tags text {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #2f7d6b;
  background: rgba(143, 175, 138, 0.14);
  font-size: 20rpx;
}

.rating {
  color: #2f7d6b;
  font-size: 30rpx;
  font-weight: 700;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.slot {
  padding: 24rpx;
  border: 2rpx solid rgba(92, 72, 48, 0.1);
  border-radius: 28rpx;
  background: rgba(255, 253, 248, 0.82);
}

.slot view {
  color: #24342f;
  font-size: 28rpx;
  font-weight: 700;
}

.slot text {
  color: #81786b;
  font-size: 22rpx;
}

.slot.disabled {
  opacity: 0.45;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  height: 92rpx;
  line-height: 1;
}
