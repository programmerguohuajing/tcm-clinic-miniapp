.booking-hero {
  padding: 42rpx;
  background:
    linear-gradient(145deg, rgba(43, 39, 34, 0.94), rgba(94, 84, 70, 0.82)),
    radial-gradient(circle at 82% 12%, rgba(187, 169, 143, 0.28), transparent 230rpx);
}

.booking-hero .title,
.booking-hero .subtitle {
  color: #f8ead1;
}

.booking-hero .eyebrow {
  color: #d8c39e;
}

.chip-scroll {
  white-space: nowrap;
}

.service-chip {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  width: 290rpx;
  height: 132rpx;
  margin-right: 18rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(47, 43, 37, 0.08);
  border-radius: 34rpx;
  color: #2b2722;
  background: rgba(255, 250, 243, 0.64);
  box-sizing: border-box;
}

.service-chip view {
  font-size: 28rpx;
  font-weight: 700;
}

.service-chip text {
  margin-top: 10rpx;
  color: #8c8172;
  font-size: 22rpx;
}

.service-chip.active,
.practitioner-card.active,
.slot.active {
  border-color: #9b7947;
  background: rgba(255, 247, 230, 0.86);
  box-shadow: 0 18rpx 40rpx rgba(47, 43, 37, 0.1);
}

.practitioner-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(47, 43, 37, 0.06);
}

.avatar {
  width: 118rpx;
  height: 118rpx;
  border-radius: 999rpx;
  filter: saturate(0.68);
}

.practitioner-main {
  flex: 1;
}

.practitioner-name {
  color: #2b2722;
  font-size: 30rpx;
  font-weight: 700;
}

.practitioner-name text {
  color: #8c8172;
  font-size: 22rpx;
  font-weight: 400;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.tags text {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #6f5836;
  background: rgba(187, 169, 143, 0.18);
  font-size: 20rpx;
}

.rating {
  color: #9b7947;
  font-size: 30rpx;
  font-weight: 700;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.slot {
  padding: 24rpx;
  border: 2rpx solid rgba(47, 43, 37, 0.08);
  border-radius: 32rpx;
  background: rgba(255, 250, 243, 0.68);
}

.slot view {
  color: #2b2722;
  font-size: 28rpx;
  font-weight: 700;
}

.slot text {
  color: #8c8172;
  font-size: 22rpx;
}

.slot.disabled {
  opacity: 0.45;
}

.submit-button {
  margin-top: 40rpx;
  height: 92rpx;
  line-height: 92rpx;
}
