.confirm-page {
  display: flex;
  align-items: center;
}

.confirm-card {
  width: 100%;
  padding: 60rpx 42rpx;
  text-align: center;
  background: #ffffff;
}

.seal {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 28rpx;
  border: 2rpx solid #dee1e4;
  border-radius: 999rpx;
  color: #e76f3c;
  font-size: 70rpx;
  line-height: 120rpx;
  background: #fff0e7;
  box-shadow: 0 16rpx 34rpx rgba(231, 111, 60, 0.14);
}

.confirm-card button {
  margin-top: 42rpx;
}
