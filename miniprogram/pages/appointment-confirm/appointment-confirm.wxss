.confirm-page {
  display: flex;
  align-items: center;
}

.confirm-card {
  width: 100%;
  padding: 60rpx 42rpx;
  text-align: center;
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.96), rgba(231, 247, 241, 0.78)),
    radial-gradient(circle at 50% 4%, rgba(185, 242, 223, 0.55), transparent 260rpx);
}

.seal {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 28rpx;
  border: 2rpx solid #c8ebde;
  border-radius: 999rpx;
  color: #18a67d;
  font-size: 70rpx;
  line-height: 120rpx;
  background: #e7f7f1;
  box-shadow: 0 16rpx 34rpx rgba(24, 166, 125, 0.14);
}

.confirm-card button {
  margin-top: 42rpx;
}
