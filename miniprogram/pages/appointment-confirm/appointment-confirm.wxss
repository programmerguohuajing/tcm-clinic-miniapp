.confirm-page {
  display: flex;
  align-items: center;
}

.confirm-card {
  width: 100%;
  padding: 60rpx 42rpx;
  text-align: center;
}

.seal {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 28rpx;
  border: 2rpx solid rgba(47, 125, 107, 0.34);
  border-radius: 999rpx;
  color: #2f7d6b;
  font-size: 70rpx;
  line-height: 120rpx;
  background: rgba(143, 175, 138, 0.14);
}

.confirm-card button {
  margin-top: 42rpx;
}
