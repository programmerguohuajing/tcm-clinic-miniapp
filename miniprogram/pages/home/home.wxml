<!--
THESIS: A service-first clinic home that makes the next booking step obvious and refuses the promotional wellness-template homepage.
OWN-WORLD: Cool gray canvas, charcoal type, white surfaces, hairline borders, and mandarin orange reserved for action, selection, and route progress.
STORY: The visitor recognizes the clinic, chooses a service, and knows how to reach a confirmed slot before browsing health content.
FIRST VIEWPORT: Clinic identity and location first; one appointment action and its service-to-time path above service cards, content, and the four-tab navigation.
FORM: Operate mode, restrained palette strategy, approved Service Orange direction B; concept seed d3743ff9.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->
<view class="page">
  <view wx:if="{{loading}}" class="loading-mask"><view class="loading-spinner"></view></view>
  <view class="home-header">
    <view>
      <view class="home-brand">中医馆</view>
      <view wx:if="{{store}}" class="home-store">{{store.name}} · {{store.business_hours}}</view>
    </view>
    <view class="home-header-mark"><view></view><view></view><view></view></view>
  </view>

  <view class="hero-card home-hero">
    <view class="home-hero-top">
      <view class="title">{{hero.headline}}</view>
      <view class="home-hero-arrow">›</view>
    </view>
    <view class="subtitle">{{hero.subtitle}}</view>
    <button class="primary-button hero-button" bindtap="goBooking">{{hero.button}}</button>
  </view>

  <view class="booking-route">
    <view class="route-step active"><text>01</text><label>选择服务</label></view>
    <view class="route-line"></view>
    <view class="route-step"><text>02</text><label>选择技师</label></view>
    <view class="route-line"></view>
    <view class="route-step"><text>03</text><label>选择时段</label></view>
  </view>

  <view class="section-title">
    <text>服务项目</text>
    <text class="muted">查看全部 ›</text>
  </view>
  <scroll-view scroll-x class="activity-scroll">
    <block wx:for="{{activities}}" wx:key="id">
      <view class="activity-card" bindtap="goActivityDetail" data-id="{{item.id}}">
        <image class="activity-cover" src="{{item.cover_url}}" mode="aspectFill" lazy-load />
        <view class="pill activity-tag">{{item.tag}}</view>
        <view class="activity-title">{{item.title}}</view>
        <view class="subtitle">{{item.subtitle}}</view>
        <view class="activity-bottom">
          <text class="price">¥{{item.price}}</text>
          <text class="origin">¥{{item.original_price}}</text>
        </view>
      </view>
    </block>
  </scroll-view>

  <view class="section-title">
    <text>健康资讯</text>
    <text class="muted">查看更多 ›</text>
  </view>
  <block wx:for="{{articles}}" wx:key="id">
    <view class="list-card article-card" bindtap="goArticleDetail" data-id="{{item.id}}">
      <image class="article-cover" src="{{item.cover_url}}" mode="aspectFill" lazy-load />
      <view class="article-body">
        <view class="pill">{{item.category}}</view>
        <view class="article-title">{{item.title}}</view>
        <view class="subtitle">{{item.summary}}</view>
        <view class="muted">{{item.read_minutes}} 分钟阅读</view>
      </view>
    </view>
  </block>
</view>

<!-- Phone auth overlay -->
<view wx:if="{{showPhoneOverlay}}" class="phone-overlay">
  <view class="phone-overlay-backdrop"></view>
  <view class="phone-overlay-card">
    <view class="phone-overlay-icon">+</view>
    <view class="phone-overlay-title">欢迎来到青囊中医馆</view>
    <view class="phone-overlay-desc">请先授权手机号\n为您开启完整的疗愈体验</view>
    <view class="phone-overlay-features">
      <view class="phone-overlay-feature"><text class="phone-overlay-feature-icon">✓</text><text>在线预约服务</text></view>
      <view class="phone-overlay-feature"><text class="phone-overlay-feature-icon">✓</text><text>查看健康档案</text></view>
      <view class="phone-overlay-feature"><text class="phone-overlay-feature-icon">✓</text><text>会员积分管理</text></view>
      <view class="phone-overlay-feature"><text class="phone-overlay-feature-icon">✓</text><text>预约消息提醒</text></view>
    </view>
    <button class="phone-overlay-button" bindtap="goToLogin">微信手机号一键登录</button>
    <view class="phone-overlay-terms">登录即同意《用户协议》和《隐私政策》</view>
  </view>
</view>
