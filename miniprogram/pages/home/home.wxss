.home-hero {
  min-height: 600rpx;
  padding: 42rpx;
  background:
    linear-gradient(145deg, rgba(255, 250, 243, 0.72), rgba(221, 211, 197, 0.58)),
    radial-gradient(circle at 72% 18%, rgba(187, 169, 143, 0.34), transparent 260rpx);
}

.home-hero .title {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  max-width: 560rpx;
}

.home-hero .subtitle {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  max-width: 560rpx;
}

.hero-button {
  position: relative;
  z-index: 1;
  width: 260rpx;
  margin: 34rpx 0 0;
}

.retreat-photo {
  position: relative;
  height: 260rpx;
  margin: 28rpx 0 8rpx;
  border-radius: 36rpx;
  background:
    linear-gradient(135deg, rgba(187, 169, 143, 0.92), rgba(238, 231, 220, 0.3)),
    radial-gradient(circle at 24% 24%, rgba(255, 247, 230, 0.82), transparent 110rpx);
  overflow: hidden;
}

.retreat-photo::after {
  content: "";
  position: absolute;
  right: 34rpx;
  bottom: -50rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 999rpx;
  background: rgba(43, 39, 34, 0.16);
}

.moon {
  position: absolute;
  left: 42rpx;
  top: 42rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle at 36% 34%, #fff9ea, #bba98f);
}

.incense-line {
  position: absolute;
  left: 188rpx;
  top: 76rpx;
  width: 2rpx;
  height: 138rpx;
  background: rgba(47, 43, 37, 0.26);
  box-shadow: 32rpx 28rpx 0 rgba(47, 43, 37, 0.12), 64rpx -10rpx 0 rgba(47, 43, 37, 0.1);
}

.ritual-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}

.ritual-row view {
  padding: 24rpx 0;
  border: 1rpx solid rgba(47, 43, 37, 0.1);
  border-radius: 999rpx;
  color: #5d5145;
  background: rgba(255, 250, 243, 0.52);
  text-align: center;
  box-shadow: 0 14rpx 34rpx rgba(47, 43, 37, 0.06);
}

.activity-scroll {
  white-space: nowrap;
}

.activity-card {
  display: inline-block;
  width: 520rpx;
  margin-right: 22rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(47, 43, 37, 0.1);
  border-radius: 38rpx;
  background: rgba(255, 250, 243, 0.72);
  box-shadow: 0 24rpx 58rpx rgba(47, 43, 37, 0.1);
  vertical-align: top;
}

.activity-cover {
  width: 100%;
  height: 260rpx;
  border-radius: 30rpx;
  filter: saturate(0.72) contrast(0.96);
}

.activity-tag {
  margin-top: 18rpx;
}

.activity-title {
  margin-top: 14rpx;
  color: #2b2722;
  font-size: 32rpx;
  font-weight: 700;
}

.activity-bottom {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 18rpx;
}

.origin {
  color: #a59a8b;
  font-size: 24rpx;
  text-decoration: line-through;
}

.article-card {
  display: flex;
  gap: 22rpx;
  margin-bottom: 22rpx;
  padding: 20rpx;
}

.article-cover {
  flex: none;
  width: 180rpx;
  height: 180rpx;
  border-radius: 30rpx;
  filter: saturate(0.72);
}

.article-body {
  flex: 1;
}

.article-title {
  margin-top: 10rpx;
  color: #2b2722;
  font-size: 30rpx;
  font-weight: 700;
}
