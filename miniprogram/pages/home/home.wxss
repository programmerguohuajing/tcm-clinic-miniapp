.home-hero {
  min-height: 596rpx;
  padding: 38rpx;
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.96), rgba(231, 247, 241, 0.72)),
    radial-gradient(circle at 76% 12%, rgba(185, 242, 223, 0.48), transparent 250rpx);
}

.home-hero .title {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  max-width: 560rpx;
}

.home-hero .subtitle {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  max-width: 560rpx;
}

.hero-button {
  position: relative;
  z-index: 1;
  width: 244rpx;
  margin: 32rpx 0 0;
}

.retreat-photo {
  position: relative;
  height: 252rpx;
  margin: 28rpx 0 8rpx;
  overflow: hidden;
  border: 1rpx solid rgba(200, 235, 222, 0.92);
  border-radius: 34rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(231, 247, 241, 0.86)),
    radial-gradient(circle at 24% 22%, rgba(185, 242, 223, 0.72), transparent 130rpx);
}

.retreat-photo::after {
  content: "";
  position: absolute;
  right: 34rpx;
  bottom: -56rpx;
  width: 230rpx;
  height: 230rpx;
  border: 1rpx solid rgba(24, 166, 125, 0.08);
  border-radius: 999rpx;
  background: rgba(24, 166, 125, 0.08);
}

.moon {
  position: absolute;
  left: 42rpx;
  top: 42rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle at 34% 32%, #ffffff, #b9f2df);
  box-shadow: 0 12rpx 34rpx rgba(24, 166, 125, 0.18);
}

.incense-line {
  position: absolute;
  left: 188rpx;
  top: 76rpx;
  width: 2rpx;
  height: 138rpx;
  background: rgba(16, 36, 30, 0.16);
  box-shadow: 32rpx 28rpx 0 rgba(16, 36, 30, 0.09), 64rpx -10rpx 0 rgba(16, 36, 30, 0.07);
}

.ritual-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.ritual-row view {
  min-width: 0;
  padding: 22rpx 0;
  border: 1rpx solid #c8ebde;
  border-radius: 999rpx;
  color: #18a67d;
  background: rgba(255, 255, 255, 0.86);
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.activity-scroll {
  white-space: nowrap;
}

.activity-card {
  display: inline-block;
  width: 520rpx;
  margin-right: 22rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(200, 235, 222, 0.9);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 36rpx rgba(16, 36, 30, 0.08);
  vertical-align: top;
  box-sizing: border-box;
}

.activity-cover {
  width: 100%;
  height: 260rpx;
  border-radius: 28rpx;
  background: #e7f7f1;
  filter: saturate(0.92) contrast(1.02);
}

.activity-tag {
  margin-top: 18rpx;
}

.activity-title {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: #10241e;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: normal;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.activity-bottom {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 18rpx;
}

.origin {
  color: #8aa099;
  font-size: 24rpx;
  text-decoration: line-through;
}

.article-card {
  display: flex;
  gap: 22rpx;
  margin-bottom: 22rpx;
  padding: 20rpx;
  align-items: center;
}

.article-cover {
  flex: none;
  width: 180rpx;
  height: 180rpx;
  border-radius: 30rpx;
  background: #e7f7f1;
  filter: saturate(0.92);
}

.article-body {
  min-width: 0;
  flex: 1;
}

.article-title {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #10241e;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
