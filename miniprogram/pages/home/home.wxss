.home-hero {
  min-height: 600rpx;
  padding: 42rpx;
  background:
    linear-gradient(145deg, rgba(255, 253, 248, 0.92), rgba(247, 241, 230, 0.78)),
    radial-gradient(circle at 76% 14%, rgba(143, 175, 138, 0.16), transparent 250rpx);
}

.home-hero .title {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  max-width: 560rpx;
}

.home-hero .subtitle {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  max-width: 560rpx;
}

.hero-button {
  position: relative;
  z-index: 1;
  width: 260rpx;
  margin: 34rpx 0 0;
}

.retreat-photo {
  position: relative;
  height: 260rpx;
  margin: 28rpx 0 8rpx;
  overflow: hidden;
  border: 1rpx solid rgba(47, 125, 107, 0.1);
  border-radius: 32rpx;
  background:
    linear-gradient(135deg, rgba(255, 253, 248, 0.84), rgba(242, 234, 220, 0.78)),
    radial-gradient(circle at 26% 24%, rgba(143, 175, 138, 0.22), transparent 120rpx);
}

.retreat-photo::after {
  content: "";
  position: absolute;
  right: 34rpx;
  bottom: -56rpx;
  width: 230rpx;
  height: 230rpx;
  border: 1rpx solid rgba(47, 125, 107, 0.08);
  border-radius: 999rpx;
  background: rgba(143, 175, 138, 0.08);
}

.moon {
  position: absolute;
  left: 42rpx;
  top: 42rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle at 36% 34%, #fffdf8, #d8cfbd);
}

.incense-line {
  position: absolute;
  left: 188rpx;
  top: 76rpx;
  width: 2rpx;
  height: 138rpx;
  background: rgba(47, 58, 53, 0.2);
  box-shadow: 32rpx 28rpx 0 rgba(47, 58, 53, 0.1), 64rpx -10rpx 0 rgba(47, 58, 53, 0.08);
}

.ritual-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}

.ritual-row view {
  padding: 24rpx 0;
  border: 1rpx solid rgba(47, 125, 107, 0.12);
  border-radius: 999rpx;
  color: #3f6258;
  background: rgba(255, 253, 248, 0.72);
  text-align: center;
}

.activity-scroll {
  white-space: nowrap;
}

.activity-card {
  display: inline-block;
  width: 520rpx;
  margin-right: 22rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(92, 72, 48, 0.12);
  border-radius: 32rpx;
  background: rgba(255, 253, 248, 0.86);
  box-shadow: 0 8rpx 24rpx rgba(62, 49, 34, 0.06);
  vertical-align: top;
}

.activity-cover {
  width: 100%;
  height: 260rpx;
  border-radius: 26rpx;
  filter: saturate(0.78) contrast(0.98);
}

.activity-tag {
  margin-top: 18rpx;
}

.activity-title {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: #24342f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: normal;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.activity-bottom {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 18rpx;
}

.origin {
  color: #9d9284;
  font-size: 24rpx;
  text-decoration: line-through;
}

.article-card {
  display: flex;
  gap: 22rpx;
  margin-bottom: 22rpx;
  padding: 20rpx;
}

.article-cover {
  flex: none;
  width: 180rpx;
  height: 180rpx;
  border-radius: 26rpx;
  filter: saturate(0.76);
}

.article-body {
  min-width: 0;
  flex: 1;
}

.article-title {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #24342f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
