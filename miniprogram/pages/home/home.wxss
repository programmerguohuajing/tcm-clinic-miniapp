.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin: 4rpx 4rpx 24rpx;
}

.home-brand {
  color: #17191c;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.25;
}

.home-store {
  margin-top: 8rpx;
  color: #73777d;
  font-size: 22rpx;
  line-height: 1.4;
}

.home-header-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 72rpx;
  height: 44rpx;
  padding: 4rpx 14rpx 8rpx;
  border: 1rpx solid #dee1e4;
  border-radius: 999rpx;
  color: #2d3035;
  background: #ffffff;
}

.home-header-mark view {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #2d3035;
}

.home-hero {
  padding: 32rpx;
  background: #ffffff;
}

.home-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.home-hero .title {
  min-width: 0;
  flex: 1;
  max-width: 560rpx;
}

.home-hero-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  color: #ffffff;
  background: #e76f3c;
  font-size: 42rpx;
  line-height: 1;
}

.home-hero .subtitle {
  max-width: 560rpx;
  margin-top: 18rpx;
}

.hero-button {
  width: 244rpx;
  margin: 28rpx 0 0;
}

.booking-route {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid #dee1e4;
  border-radius: 20rpx;
  background: #ffffff;
}

.route-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 112rpx;
  gap: 8rpx;
  color: #73777d;
  font-size: 22rpx;
  line-height: 1.2;
  text-align: center;
}

.route-step text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border: 1rpx solid #dee1e4;
  border-radius: 50%;
  color: #73777d;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
}

.route-step.active {
  color: #e76f3c;
  font-weight: 800;
}

.route-step.active text {
  border-color: #e76f3c;
  color: #ffffff;
  background: #e76f3c;
}

.route-line {
  height: 1rpx;
  flex: 1;
  margin: 0 6rpx 28rpx;
  background: #dee1e4;
}

.activity-scroll {
  white-space: nowrap;
}

.activity-card {
  display: inline-block;
  width: 520rpx;
  margin-right: 18rpx;
  padding: 16rpx;
  border: 1rpx solid #dee1e4;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(45, 48, 53, 0.06);
  vertical-align: top;
  box-sizing: border-box;
}

.activity-cover {
  width: 100%;
  height: 248rpx;
  border-radius: 14rpx;
  background: #fff0e7;
  filter: saturate(0.92) contrast(1.02);
}

.activity-tag {
  margin-top: 16rpx;
}

.activity-title {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: #2d3035;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: normal;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.activity-bottom {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 16rpx;
}

.origin {
  color: #9aa0a6;
  font-size: 24rpx;
  text-decoration: line-through;
}

.article-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 16rpx;
}

.article-cover {
  flex: none;
  width: 176rpx;
  height: 176rpx;
  border-radius: 14rpx;
  background: #fff0e7;
  filter: saturate(0.92);
}

.article-body {
  min-width: 0;
  flex: 1;
}

.article-title {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #2d3035;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* Phone auth overlay */
.phone-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.phone-overlay-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(45, 48, 53, 0.45);
}

.phone-overlay-card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-height: 78vh;
  padding: 42rpx 36rpx 40rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 -10rpx 28rpx rgba(45, 48, 53, 0.12);
  overflow-y: auto;
}

.phone-overlay-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: #e76f3c;
  font-size: 42rpx;
  line-height: 1;
}

.phone-overlay-title {
  color: #2d3035;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}

.phone-overlay-desc {
  color: #73777d;
  font-size: 26rpx;
  text-align: center;
  line-height: 1.5;
  white-space: pre-line;
}

.phone-overlay-features {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 14rpx 0;
}

.phone-overlay-feature {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #dee1e4;
  border-radius: 16rpx;
  background: #f4f5f6;
  color: #2d3035;
  font-size: 24rpx;
  font-weight: 700;
}

.phone-overlay-feature-icon {
  color: #e76f3c;
  font-size: 28rpx;
  font-weight: 800;
}

.phone-overlay-button {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 18rpx;
  color: #ffffff;
  background: #e76f3c;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx rgba(231, 111, 60, 0.2);
}

.phone-overlay-terms {
  color: #9aa0a6;
  font-size: 22rpx;
  text-align: center;
}
