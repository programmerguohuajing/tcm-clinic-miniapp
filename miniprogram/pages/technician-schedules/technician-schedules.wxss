.schedule-hero {
  padding: 38rpx;
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.96), rgba(231, 247, 241, 0.74)),
    radial-gradient(circle at 82% 12%, rgba(185, 242, 223, 0.5), transparent 230rpx);
}

.form-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 86rpx;
  border-bottom: 1rpx solid rgba(200, 235, 222, 0.8);
  color: #10241e;
  font-size: 28rpx;
}

.form-row:last-of-type {
  border-bottom: 0;
}

.field-value,
.field-input {
  min-width: 0;
  color: #18a67d;
  text-align: right;
}

.field-input {
  width: 180rpx;
  word-break: break-all;
}

.save-button {
  margin-top: 28rpx;
  height: 82rpx;
  font-size: 28rpx;
  line-height: 82rpx;
}

.schedule-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.schedule-info {
  min-width: 0;
  flex: 1;
}

.order-title {
  color: #10241e;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.empty-card {
  padding: 34rpx;
  color: #6a7c75;
  text-align: center;
}
