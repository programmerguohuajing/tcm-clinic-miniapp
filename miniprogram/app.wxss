page {
  min-height: 100%;
  color: #10241e;
  background:
    radial-gradient(circle at 12% 0%, rgba(185, 242, 223, 0.5), transparent 30%),
    radial-gradient(circle at 92% 8%, rgba(52, 120, 246, 0.08), transparent 26%),
    linear-gradient(180deg, #f4fbf8 0%, #f8fffc 48%, #eef8f4 100%);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  overflow-wrap: break-word;
  word-break: break-word;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 56rpx;
  box-sizing: border-box;
}

.hero-card,
.section-card,
.list-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(200, 235, 222, 0.9);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 44rpx rgba(16, 36, 30, 0.08);
  box-sizing: border-box;
}

.hero-card::after {
  content: "";
  position: absolute;
  right: -96rpx;
  top: -112rpx;
  width: 260rpx;
  height: 260rpx;
  border: 1rpx solid rgba(47, 125, 107, 0.08);
  border-radius: 999rpx;
  background: rgba(185, 242, 223, 0.3);
}

.eyebrow {
  color: #18a67d;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.title {
  color: #10241e;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
  letter-spacing: 0;
}

.subtitle {
  color: #6a7c75;
  font-size: 26rpx;
  line-height: 1.62;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-width: 0;
  margin: 44rpx 0 20rpx;
  color: #10241e;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.28;
}

.section-title text:first-child {
  min-width: 0;
  flex: 1;
}

.pill {
  display: inline-block;
  min-height: 46rpx;
  max-width: 100%;
  padding: 0 20rpx;
  border: 1rpx solid #c8ebde;
  border-radius: 999rpx;
  color: #18a67d;
  background: #e7f7f1;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
  box-sizing: border-box;
  word-break: break-all;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  padding: 0 30rpx;
  border: none;
  border-radius: 999rpx;
  color: #ffffff;
  background: #18a67d;
  box-shadow: 0 18rpx 34rpx rgba(24, 166, 125, 0.22);
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.25;
  white-space: normal;
}

.primary-button::after,
.ghost-button::after {
  border: 0;
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #c8ebde;
  border-radius: 999rpx;
  color: #18a67d;
  background: rgba(255, 255, 255, 0.86);
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.25;
  white-space: normal;
}

.grid-two {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.muted {
  color: #6a7c75;
  line-height: 1.45;
}

.price {
  color: #18a67d;
  font-weight: 800;
}

button {
  margin: 0;
}

image {
  display: block;
}

input,
textarea {
  font: inherit;
}

.empty-card,
.empty {
  color: #6a7c75;
}
