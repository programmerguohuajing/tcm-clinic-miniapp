page {
  min-height: 100%;
  color: #2f3a35;
  background:
    radial-gradient(circle at 12% 0%, rgba(143, 175, 138, 0.18), transparent 30%),
    linear-gradient(180deg, #f7f1e6 0%, #fbf7ef 52%, #f2eadc 100%);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  overflow-wrap: break-word;
  word-break: break-word;
}

.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 44rpx;
  box-sizing: border-box;
}

.hero-card,
.section-card,
.list-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(92, 72, 48, 0.12);
  border-radius: 32rpx;
  background: rgba(255, 253, 248, 0.88);
  box-shadow: 0 8rpx 24rpx rgba(62, 49, 34, 0.06);
}

.hero-card::after {
  content: "";
  position: absolute;
  right: -120rpx;
  top: -120rpx;
  width: 280rpx;
  height: 280rpx;
  border: 1rpx solid rgba(47, 125, 107, 0.08);
  border-radius: 999rpx;
  background: rgba(143, 175, 138, 0.08);
}

.eyebrow {
  color: #81715f;
  font-size: 22rpx;
  letter-spacing: 5rpx;
  text-transform: uppercase;
}

.title {
  color: #24342f;
  font-family: "Songti SC", "STSong", "PingFang SC", serif;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: -1rpx;
}

.subtitle {
  color: #6f675d;
  font-size: 26rpx;
  line-height: 1.68;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 46rpx 0 20rpx;
  color: #24342f;
  font-family: "Songti SC", "STSong", "PingFang SC", serif;
  font-size: 36rpx;
  font-weight: 700;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(47, 125, 107, 0.16);
  border-radius: 999rpx;
  color: #2f7d6b;
  background: rgba(143, 175, 138, 0.14);
  font-size: 22rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border: none;
  border-radius: 999rpx;
  color: #fffdf8;
  background: #2f7d6b;
  box-shadow: 0 14rpx 30rpx rgba(47, 125, 107, 0.18);
  box-sizing: border-box;
  line-height: 1.25;
}

.primary-button::after,
.ghost-button::after {
  border: 0;
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(47, 125, 107, 0.18);
  border-radius: 999rpx;
  color: #2f7d6b;
  background: rgba(255, 253, 248, 0.76);
  box-sizing: border-box;
  line-height: 1.25;
}

.grid-two {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.muted {
  color: #81786b;
}

.price {
  color: #2f7d6b;
  font-weight: 700;
}
