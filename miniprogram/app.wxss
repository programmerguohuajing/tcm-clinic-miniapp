page {
  min-height: 100%;
  color: #2d3035;
  background: #f4f5f6;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  overflow-wrap: break-word;
  word-break: break-word;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 56rpx;
  box-sizing: border-box;
}

.hero-card,
.section-card,
.list-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid #dee1e4;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(45, 48, 53, 0.06);
}

.hero-card::after {
  display: none;
}

.eyebrow {
  display: none;
}

.title {
  color: #17191c;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
  letter-spacing: -1rpx;
}

.subtitle {
  color: #73777d;
  font-size: 26rpx;
  line-height: 1.62;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-width: 0;
  margin: 40rpx 0 18rpx;
  color: #2d3035;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.28;
}

.section-title text:first-child {
  min-width: 0;
  flex: 1;
}

.pill {
  display: inline-block;
  min-height: 44rpx;
  max-width: 100%;
  padding: 0 16rpx;
  border: 1rpx solid #ffd8c7;
  border-radius: 12rpx;
  color: #e76f3c;
  background: #fff0e7;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 42rpx;
  box-sizing: border-box;
  word-break: break-all;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border: none;
  border-radius: 18rpx;
  color: #ffffff;
  background: #e76f3c;
  box-shadow: 0 10rpx 22rpx rgba(231, 111, 60, 0.2);
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.25;
  white-space: normal;
}

.primary-button::after,
.ghost-button::after {
  border: 0;
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dee1e4;
  border-radius: 18rpx;
  color: #2d3035;
  background: #ffffff;
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.25;
  white-space: normal;
}

.grid-two {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.muted {
  color: #73777d;
  line-height: 1.45;
}

.price {
  color: #e76f3c;
  font-weight: 800;
}

button {
  margin: 0;
}

image {
  display: block;
}

input,
textarea {
  font: inherit;
}

/* Loading mask */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-spinner {
  width: 48px;
  height: 48px;
  border: 4px solid #eceef0;
  border-top-color: #e76f3c;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
